# Optional local SQLite database location, relative to backend/ when not absolute.
WEREWOLF_ARENA_DATABASE_PATH=werewolf_arena.db

# OpenAI Chat Completions compatible provider. Copy this file to .env and fill in locally.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Completion-token allowance per model call. Reasoning models may need this for a final JSON answer.
LLM_MAX_OUTPUT_TOKENS=4096
# DeepSeek thinking is enabled by default; keep it off for fast structured game decisions.
LLM_THINKING_ENABLED=false
